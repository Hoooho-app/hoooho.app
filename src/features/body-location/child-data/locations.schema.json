{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoooho.app/schemas/body-locations-1.0.0.json",
  "title": "Hoooho child body surface locations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locale",
    "scope",
    "anatomicalFrame",
    "modelSexSource",
    "globalViews",
    "regions",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "locale": {
      "const": "zh-CN"
    },
    "scope": {
      "const": "body-surface-and-visible-mucosa"
    },
    "anatomicalFrame": {
      "const": "patient-relative"
    },
    "modelSexSource": {
      "const": "currentMember.profile.sex"
    },
    "globalViews": {
      "type": "array",
      "items": {
        "enum": [
          "front",
          "back"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "use"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "use": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "views",
        "bilateral",
        "side",
        "zoom",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "type": "array",
          "items": {
            "enum": [
              "front",
              "back"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "bilateral": {
          "type": "boolean"
        },
        "side": {
          "enum": [
            "left",
            "right",
            "midline",
            "unspecified"
          ]
        },
        "pairedRegionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "zoom": {
          "enum": [
            "body",
            "face",
            "hand",
            "foot"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "side",
        "surface",
        "sex",
        "views",
        "aliases",
        "group",
        "anchorHint",
        "coverage",
        "displayMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            "midline",
            "unspecified"
          ]
        },
        "surface": {
          "enum": [
            "anterior",
            "posterior",
            "medial",
            "lateral",
            "superior",
            "inferior",
            "palmar",
            "dorsal",
            "plantar",
            "circumferential",
            "mucosal",
            "external",
            "unspecified"
          ]
        },
        "sex": {
          "type": "array",
          "items": {
            "enum": [
              "boy",
              "girl"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "views": {
          "type": "array",
          "items": {
            "enum": [
              "front",
              "back"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "anchorHint": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "specific",
            "whole",
            "uncertain"
          ]
        },
        "displayMode": {
          "enum": [
            "illustrated",
            "text"
          ]
        }
      }
    }
  }
}
