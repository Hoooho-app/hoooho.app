# Backend only. Never use VITE_ prefixes for any AI credential.
AI_PROVIDER=local
# 隔离的虚构资料测试专用，正式环境不要设置。需要测试时取消注释：
# HOOOHO_DOMESTIC_AI_TRIAL=synthetic-only
# AI_PROVIDER=ark
# ARK_API_KEY=
# ASR_PROVIDER=seed
# DOUBAO_ASR_API_KEY=
# DOCUMENT_OCR_PROVIDER=paddle
# PADDLE_OCR_URL=http://127.0.0.1:8080/layout-parsing
# 负责人 TestFlight 内测入口；只运行服务端内置虚构案例，缺任一配置则不显示。
# HOOOHO_SEED_TRIAL_HOOOHO_ID=
# HOOOHO_SEED_TRIAL_API_KEY=
# 杭州负责人专用 TestFlight 首页。方舟与豆包语音均实测后才启用。
# HOOOHO_SEED_HOME_TESTFLIGHT=true
# To explicitly switch text/image AI: AI_PROVIDER=openrouter. Keep ASR/TTS independent.
# Create a limited key on OpenRouter; never paste it into client code or git.
OPENROUTER_API_KEY=
# Copy a fixed provider/model ID with JSON Schema support from the model catalog.
OPENROUTER_MODEL=
# Optional independent image-capable model; defaults to OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_OUTPUT_TOKENS=8000
BAILIAN_API_KEY=
# Paste the complete Beijing OpenAI-compatible Base URL from YOUR console.
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen3.7-plus-2026-05-26
BAILIAN_VISION_MODEL=qwen3.7-plus-2026-05-26
BAILIAN_TIMEOUT_MS=60000
BAILIAN_MAX_OUTPUT_TOKENS=8000
BAILIAN_MAX_INPUT_CHARACTERS=65000
BAILIAN_MAX_IMAGES_PER_REQUEST=1
AI_MAX_CALLS_PER_ACCOUNT_HOUR=30
AI_MAX_CONCURRENT_CALLS=2
AI_DRAFT_MAX_CALLS=14
ASR_PROVIDER=none
TTS_PROVIDER=none
# Existing OpenAI settings remain supported; no keys included here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# Operations backend: isolated private billing browser (no VITE_ prefixes).
OPS_CAPTURE_WORKER_URL=
OPS_CAPTURE_WORKER_TOKEN=
# Optional legacy adapter; use in-console authorization for new connections.
OPS_BROWSER_CDP_URL=
OPS_CAPTURE_PROFILES=
