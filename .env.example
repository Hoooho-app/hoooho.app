# Backend only. Never use VITE_ prefixes for any AI credential.
AI_PROVIDER=local
BAILIAN_API_KEY=
# Paste the complete Beijing OpenAI-compatible Base URL from YOUR console.
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_VISION_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_MS=60000
BAILIAN_MAX_OUTPUT_TOKENS=8000
BAILIAN_MAX_INPUT_CHARACTERS=65000
BAILIAN_MAX_IMAGES_PER_REQUEST=1
AI_MAX_CALLS_PER_ACCOUNT_HOUR=30
AI_MAX_CONCURRENT_CALLS=2
AI_DRAFT_MAX_CALLS=14
ASR_PROVIDER=none
TTS_PROVIDER=none
# Existing OpenAI settings remain supported; no keys included here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
