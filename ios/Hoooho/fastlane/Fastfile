require "securerandom"
require "fileutils"
require "json"

default_platform(:ios)

platform :ios do
  desc "Reuse verified signing assets, upload a normal build, and wait for TestFlight processing"
  lane :beta do
    bundle_id = ENV.fetch("IOS_BUNDLE_ID")
    team_id = ENV.fetch("IOS_TEAM_ID")
    app_id = ENV.fetch("ASC_APP_ID")
    UI.user_error!("Use a verified registered bundle ID") if bundle_id == "com.hoooho.records.preview"
    signing_dir = File.join(ENV.fetch("RUNNER_TEMP"), "hoooho-signing")
    FileUtils.mkdir_p(signing_dir, mode: 0700)
    key_file = File.join(signing_dir, "AuthKey.p8")
    File.write(key_file, ENV.fetch("ASC_API_KEY_P8"), mode: "w", perm: 0600)
    keychain_password = SecureRandom.hex(32)
    create_keychain(name: "hoooho-ci", password: keychain_password, default_keychain: true, unlock: true, timeout: 3600, lock_when_sleeps: true)
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: key_file, in_house: false)
    import_certificate(certificate_path: File.join(signing_dir, "distribution.p12"), certificate_password: ENV.fetch("IOS_DISTRIBUTION_P12_PASSWORD"), keychain_name: "hoooho-ci", keychain_password: keychain_password)
    profile = JSON.parse(File.read(File.join(signing_dir, "profile.json")))
    profile_uuid = profile.fetch("uuid")
    profile_name = profile.fetch("name")
    # A retried run must never reuse a build already accepted by Apple.
    # CFBundleVersion permits three integer components; major is at most four digits.
    run_number = Integer(ENV.fetch("GITHUB_RUN_NUMBER", "1"))
    attempt = Integer(ENV.fetch("GITHUB_RUN_ATTEMPT", "1"))
    UI.user_error!("Build number range exhausted") unless run_number.between?(1, 999_899) && attempt.between?(1, 99)
    build_number = "#{run_number / 100 + 1}.#{run_number % 100}.#{attempt}"
    build_app(project: "HooohoRecords.xcodeproj", scheme: "HooohoRecords", clean: true,
      output_directory: File.join(signing_dir, "output"), output_name: "HooohoRecords.ipa",
      export_method: "app-store", include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id} CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{profile_uuid}' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {signingStyle: "manual", teamID: team_id, provisioningProfiles: {bundle_id => profile_name}})
    upload_to_testflight(api_key: api_key, app_identifier: bundle_id, apple_id: app_id,
      ipa: File.join(signing_dir, "output", "HooohoRecords.ipa"), distribute_external: false,
      skip_waiting_for_build_processing: false, skip_submission: true, submit_beta_review: false)
    # CI needs only a Developer-role key. Metadata, compliance and group assignment
    # are completed in the owner's signed-in App Store Connect session.
    # Never let pilot's default encryption declaration run via distribution.
    UI.success("Apple build processing finished. Verify export compliance, What to Test and internal group assignment in App Store Connect; installation is not yet verified.")
  end
end
